# Browser-visible. The anon key is safe to ship only because row-level security is on.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-only. Never prefix these with VITE_.
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Optional. getFeedback() reads this.
# llama-3.3-70b-versatile is Groq's current Llama 3.3 model (enterprise as of Nov 2026).
# Free-tier keys were cut off from Llama chat models on Aug 16, 2026.
# Leave this as-is to try Llama first; getFeedback() retries openai/gpt-oss-20b
# if Groq says that Llama model is unavailable. Or set the free model directly:
# GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL=llama-3.3-70b-versatile
